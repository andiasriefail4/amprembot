# =============================================
# Resend API Key (untuk pengiriman email)
# Daftar gratis di https://resend.com
# =============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# Domain pengirim email (harus diverifikasi di Resend)
# Contoh: mail.yourdomain.com
# =============================================
RESEND_FROM_DOMAIN=yourdomain.com

# =============================================
# Solver Service Turnstile URL
# =============================================
SOLVER_URL=https://rbot.duar.eu.cc/api/turnstile

# =============================================
# Telegram Bot Token (opsional, jika pakai bot integration)
# =============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_SECRET=your_webhook_secret_here

# =============================================
# App Port (opsional, untuk local dev)
# =============================================
PORT=3000
